<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <Style src="project://database/Packages/io.continis.blackbox/UI/UIToolkit/BB_Styles.uss?fileID=7433441132597879392&amp;guid=d44be3474fc224dd28581e25055240cf&amp;type=3#BB_Styles"/>
    <ui:VisualElement name="RevealedObjectReference" class="PropertyLine" style="flex-direction: row; flex-wrap: wrap;">
        <ui:Button text="+" parse-escape-sequences="false" display-tooltip-when-elided="true" enable-rich-text="false" name="AddRemoveButton" tooltip="Click to reveal a reference to this object." class="AddRemoveBtn"/>
        <ui:Label text="GO" parse-escape-sequences="true" display-tooltip-when-elided="true" name="TypeLabel" tooltip="A child GameObject." class="TypeLabel"/>
        <ui:VisualElement name="RevealedName" class="RevealedAsField" style="flex-basis: 0; flex-shrink: 1; width: 0; min-width: 0; flex-grow: 0;"/>
        <uie:ObjectField name="ActualProp" focusable="true" enabled="false" label="Child GO" class="object-field_no-picker unity-base-field__aligned"/>
    </ui:VisualElement>
</ui:UXML>
