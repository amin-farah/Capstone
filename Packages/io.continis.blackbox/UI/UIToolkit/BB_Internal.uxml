<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="True">
    <Style src="project://database/Packages/io.continis.blackbox/UI/UIToolkit/BB_Styles.uss?fileID=7433441132597879392&amp;guid=d44be3474fc224dd28581e25055240cf&amp;type=3#BB_Styles"/>
    <ui:VisualElement name="InitialSpace"/>
    <ui:VisualElement name="OverrideHeader">
        <ui:HelpBox message-type="Info" text="Adding overrides to BlackBox." name="ExperimentalMessage" tooltip="You are adding overrides to BlackBox, meaning that you can modify how this BlackBox component behaves or add/remove Revealed lists or elements. Adding overrides is an experimental workflow." class="links-no-underline"/>
        <ui:Button name="OverridesBackButton" tooltip="Press the button to stop adding overrides to BlackBox." class="mini-button"/>
    </ui:VisualElement>
    <ui:Toggle label="Locked" name="LockedProperty" tooltip="When the Prefab is locked, all its children and root components are hidden (unless revealed using Reveal Lists, below)." binding-path="_locked" class="unity-base-field__aligned"/>
    <ui:Toggle label="Disable Apply" name="DisableApplyProperty" tooltip="Disable the ability to Apply Prefab overrides. Revert remains possible. This option also disables the Overrides dropdown." binding-path="_disableApply" class="unity-base-field__aligned"/>
    <ui:Foldout text="Options" value="false" view-data-key="BlackBox_ExtraOptions" name="Options">
        <ui:Toggle label="Hide Transform" name="HideTransformProperty" tooltip="The Transform component (or RectTransform for UI elements) is hidden too." binding-path="_hideTransform" class="unity-base-field__aligned"/>
        <ui:Label text="Keep Unlocked" name="UnlockIf" double-click-selects-word="false" triple-click-selects-line="false" tooltip="Keep the BlackBox unlocked in special cases, even if internally it&apos;s locked." display-tooltip-when-elided="false" class="indented-label"/>
        <ui:Toggle label="When Nested" name="UnlockIfNestedProperty" tooltip="Even if locked, the Prefab will show as unlocked when nested inside another Prefab." binding-path="_unlockIfNested" class="unity-base-field__aligned indented-property"/>
        <ui:Toggle label="If Variant Root" name="UnlockIfVariantRootProperty" tooltip="Even if locked, the Prefab will show as unlocked when used as the root of a Prefab Variant." binding-path="_unlockIfVariantRoot" class="unity-base-field__aligned indented-property"/>
        <ui:Toggle label="Allow Overrides to BlackBox" name="AllowBlackBoxOverridesProperty" tooltip="Allows the user to override the properties of the BlackBox component on Nested Prefabs and Variant roots. This includes properties like Locked, Disable Apply and also allows to tweak Reveal lists by adding or removing revealed items, or changing their visibility." binding-path="_allowBlackBoxOverrides" class="unity-base-field__aligned"/>
        <ui:EnumField label="Selection Type" type="BlackBox.SelectionType, BlackBox.Runtime" name="SelectionTypeProperty" tooltip="What method to use for sub-object selection in the Scene view.&lt;br&gt;&lt;br&gt;- Use Root Object uses the root GameObject, so it requires it to have a mesh or an icon.&lt;br&gt;- Use 3D Meshes uses a combined mesh of all sub-objects, which is precise but can be expensive for objects with high-detail geometry.&lt;br&gt;- Use Skinned MeshRenderers does the same, but is more suited for animated characters.&lt;br&gt;- Use Bounding Boxes simplifies the selection, by creating bounding boxes that wrap around all sub-meshes. This is less precise, but less computationally expensive that using meshes. This is also the default.&lt;br&gt;- Use Sprite Renderers creates a clickable target out of the SpriteRenderers in child objects, so it&apos;s suited for Prefabs with 2D graphics.&lt;br&gt;&lt;br&gt;&lt;b&gt;Note:&lt;/b&gt; If you choose to use anything else than Use Root Objects, you need to ensure that Gizmos are enabled in the Scene View for the object to be clickable." binding-path="_selectionType" class="unity-base-field__aligned"/>
    </ui:Foldout>
    <ui:VisualElement name="RevealedPropertiesHeader">
        <ui:Label tabindex="-1" text="Revealed items" parse-escape-sequences="false" display-tooltip-when-elided="true" enable-rich-text="false" name="RevealedPropertiesLabel"/>
        <ui:Button text="Remove all" parse-escape-sequences="true" display-tooltip-when-elided="true" name="RemoveAllButton" tooltip="Removes all revealed items. The equivalent of clicking on the Minus button on them one by one." style="display: none;"/>
        <ui:Button text="Edit lists" parse-escape-sequences="true" display-tooltip-when-elided="true" name="EditListsButton" tooltip="Allows to add, remove or reorder Reveal lists, and to change their properties."/>
    </ui:VisualElement>
    <ui:GroupBox name="ListButtonsGroup" style="flex-direction: row; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 4px; padding-left: 0;">
        <ui:Button text="+" parse-escape-sequences="true" display-tooltip-when-elided="true" name="AddListButton" class="GroupBtnRight"/>
    </ui:GroupBox>
    <ui:VisualElement name="EditModeControls">
        <ui:HelpBox message-type="Info" text="Edit mode is on. All changes are saved automatically." name="EditModeInfobox"/>
        <ui:TextField picking-mode="Ignore" label="List name" value="Designers" name="ListName" tooltip="The name of the list defines the label of its button." is-delayed="true" class="unity-base-field__aligned unity-base-field__inspector-field"/>
        <uie:EnumFlagsField label="Visibility" type="BlackBox.ListShownWhen, BlackBox.Runtime" name="ListVisibilityDropdown" value="AlwaysVisible" tooltip="Allows to display the list in all cases, or restrict its visibility to specific situations – like when the Prefab is nested or used as a Variant root. Hidden hides it completely." class="unity-base-field__aligned"/>
        <ui:Toggle label="Group by GameObject" value="true" name="ListGroupByGO" tooltip="Only affects how items are grouped on the external (Prefab instance) Inspector. The internal Inspector always shows items in list order." class="unity-base-field__aligned unity-base-field__inspector-field"/>
        <ui:VisualElement name="ListControls" style="flex-grow: 1; flex-direction: row;">
            <ui:Button text="Empty list" parse-escape-sequences="true" display-tooltip-when-elided="true" name="EmptyListBtn" tooltip="Removes all revealed items from this list." style="flex-grow: 1;"/>
            <ui:Button text="Delete list" parse-escape-sequences="true" display-tooltip-when-elided="true" name="DeleteListBtn" tooltip="Deletes the list." style="flex-grow: 1;"/>
            <ui:Button text="&lt;" parse-escape-sequences="true" display-tooltip-when-elided="true" name="MoveListLeftBtn" tooltip="Moves the list to the left." class="GroupBtnLeft"/>
            <ui:Button text="&gt;" parse-escape-sequences="true" display-tooltip-when-elided="true" name="MoveListRightBtn" tooltip="Moves the list to the right." class="GroupBtnRight"/>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="RevealedPropertiesControls">
        <ui:HelpBox message-type="Info" text="No items revealed." name="RevealedPropertiesWarning" class="links-no-underline" style="display: none;"/>
        <ui:ListView name="RevealedItemsListView" virtualization-method="DynamicHeight" show-add-remove-footer="true" reorderable="true" reorder-mode="Animated" selection-type="Multiple" show-alternating-row-backgrounds="None" show-border="true" show-bound-collection-size="false" horizontal-scrolling="false" view-data-key="RevealedItemsListView" show-foldout-header="false"/>
        <ui:Button text="Show Revealable Items" parse-escape-sequences="false" display-tooltip-when-elided="true" enable-rich-text="false" name="HideShowButton" tooltip="Show a list of child GameObjects, and the properties they possess that can be revealed on the BlackBox." style="display: flex;"/>
    </ui:VisualElement>
</ui:UXML>
